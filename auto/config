#!/bin/sh
set -e

# Keep the build strictly Debian-based and ignore the Ubuntu runner's
# live-build system defaults.
rm -f config/bootstrap config/archives/*.list.chroot config/archives/*.list.chroot_binary 2>/dev/null || true

lb config noauto \
  --mode debian \
  --ignore-system-defaults \
  --distribution trixie \
  --architectures amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --mirror-bootstrap http://deb.debian.org/debian \
  --mirror-chroot http://deb.debian.org/debian \
  --mirror-binary http://deb.debian.org/debian \
  --security false \
  --linux-packages linux-image \
  --linux-flavours amd64 \
  --debian-installer live \
  --debian-installer-gui true \
  --bootappend-live "boot=live components quiet splash" \
  --binary-images iso-hybrid \
  --iso-application "Vanilla Linux" \
  --iso-publisher "Vanilla Linux" \
  --iso-volume "VANILLA_LINUX" \
  --memtest none \
  --apt-recommends true
